{
  "name": "3D Shop - 02 Gemini Video Poller",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nitem.json.video_size = buffer.length;\nreturn [item];"
      },
      "id": "71d3fa97-c56d-4bfc-a234-07533876db7c",
      "name": "Measure Video Bytes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, -80]
    },
    {
      "parameters": {
        "content": "## Video poller\nChạy mỗi phút, lấy các job `waiting_video`, kiểm tra Gemini operation, tải video hoàn tất lên Google Drive và chuyển job sang `waiting_approval`. Chọn cùng Google/Gemini/Shop credentials như workflow 01."
      },
      "id": "e02a3d6d-8f57-4e52-af5d-3a086dbb0241",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-900, -360]
    },
    {
      "parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 1}]}},
      "id": "43e23986-e12b-4ee6-a7a4-3bef61c37be9",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-880, 0]
    },
    {
      "parameters": {
        "url": "https://REPLACE_SHOP_DOMAIN/api/v1/automation/social-jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {"parameters": [{"name": "status", "value": "waiting_video"}, {"name": "limit", "value": "10"}]},
        "options": {}
      },
      "id": "90331a65-6d9c-46b5-bfd5-9386e3c250f1",
      "name": "Get Waiting Videos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-640, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_SHOP_HEADER_AUTH_ID", "name": "Shop Automation API"}}
    },
    {
      "parameters": {"fieldToSplitOut": "data", "options": {}},
      "id": "705c7e02-6cae-4288-bf2b-ca52b9984d40",
      "name": "One Job Per Item",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "url": "=https://generativelanguage.googleapis.com/v1beta/{{ $json.media.video.operation_name }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {"response": {"response": {"neverError": true}}}
      },
      "id": "4e916fe5-4713-4a42-82bc-ec1de8fe0fd7",
      "name": "Poll Gemini Operation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_GEMINI_HEADER_AUTH_ID", "name": "Gemini API Key"}}
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [{"id": "done", "leftValue": "={{ $json.done }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "295dfeba-d963-479e-9aab-50f999252389",
      "name": "Video Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [80, 0]
    },
    {
      "parameters": {
        "jsCode": "const job = $('One Job Per Item').item.json;\nconst candidates = [\n  $json.response?.generatedVideos?.[0]?.video,\n  $json.response?.generateVideoResponse?.generatedSamples?.[0]?.video,\n  $json.response?.videos?.[0]\n].filter(Boolean);\nconst video = candidates[0] || {};\nconst uri = video.uri || video.url;\nif (!uri) throw new Error('Gemini operation hoàn tất nhưng không có video URI');\nreturn [{ json: { job_key: job.job_key, uri, file_name: `${job.job_key}-tiktok.mp4` } }];"
      },
      "id": "312cb2c9-1f75-4754-b79c-7c13fdd391f5",
      "name": "Extract Video URI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, -80]
    },
    {
      "parameters": {
        "url": "={{ $json.uri }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {"response": {"response": {"responseFormat": "file", "outputPropertyName": "data"}}, "timeout": 300000}
      },
      "id": "df56c767-a28b-4e78-a087-45a937d11ce3",
      "name": "Download Gemini Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, -80],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_GEMINI_HEADER_AUTH_ID", "name": "Gemini API Key"}}
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "={{ $('Extract Video URI').item.json.file_name }}",
        "driveId": {"__rl": true, "mode": "list", "value": "My Drive"},
        "folderId": {"__rl": true, "value": "REPLACE_GENERATED_VIDEOS_FOLDER_ID", "mode": "id"},
        "options": {}
      },
      "id": "cb737417-887e-46f4-9f8c-0d03d52ec4fa",
      "name": "Upload TikTok Video",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1040, -80],
      "credentials": {"googleDriveOAuth2Api": {"id": "REPLACE_GOOGLE_CREDENTIAL_ID", "name": "Google Drive account"}}
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://REPLACE_SHOP_DOMAIN/api/v1/automation/social-jobs/{{ $('Extract Video URI').item.json.job_key }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { status: 'waiting_approval', media: { video: { drive_file_id: $json.id, file_name: $json.name, size: Number($('Measure Video Bytes').item.json.video_size), mime_type: $json.mimeType || 'video/mp4' } } } }}",
        "options": {}
      },
      "id": "dbba3e5e-e825-40db-a44f-6c999ee15dba",
      "name": "Video Ready for Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, -80],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_SHOP_HEADER_AUTH_ID", "name": "Shop Automation API"}}
    }
  ],
  "connections": {
    "Every Minute": {"main": [[{"node": "Get Waiting Videos", "type": "main", "index": 0}]]},
    "Get Waiting Videos": {"main": [[{"node": "One Job Per Item", "type": "main", "index": 0}]]},
    "One Job Per Item": {"main": [[{"node": "Poll Gemini Operation", "type": "main", "index": 0}]]},
    "Poll Gemini Operation": {"main": [[{"node": "Video Ready?", "type": "main", "index": 0}]]},
    "Video Ready?": {"main": [[{"node": "Extract Video URI", "type": "main", "index": 0}], []]},
    "Extract Video URI": {"main": [[{"node": "Download Gemini Video", "type": "main", "index": 0}]]},
    "Download Gemini Video": {"main": [[{"node": "Measure Video Bytes", "type": "main", "index": 0}]]},
    "Measure Video Bytes": {"main": [[{"node": "Upload TikTok Video", "type": "main", "index": 0}]]},
    "Upload TikTok Video": {"main": [[{"node": "Video Ready for Approval", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1", "timezone": "Asia/Bangkok"},
