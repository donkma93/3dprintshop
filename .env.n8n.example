# Copy giá trị đầu tiên vào file .env của Laravel.
N8N_API_KEY=replace-with-a-random-string-at-least-32-characters

# Các giá trị dưới đây dùng cho stack n8n trong docker-compose.n8n.yml.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-a-second-random-string-at-least-32-characters
N8N_POSTGRES_PASSWORD=replace-with-a-strong-database-password
N8N_TIMEZONE=Asia/Bangkok
